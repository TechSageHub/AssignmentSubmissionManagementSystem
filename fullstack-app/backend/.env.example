PORT=5000

# ============================================
# Database Configuration
# ============================================
# Set DB_TYPE to 'mssql' (default) for local SQL Server, or 'postgres' for Render/PostgreSQL
# DB_TYPE=mssql

# --- SQL Server (local development) ---
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=AssignmentSystem
DB_USER=sa
DB_PASSWORD=your_password_here
DB_ENCRYPT=false

# --- PostgreSQL (Vercel/Neon production) ---
# Uncomment these and set DB_TYPE=postgres when deploying
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=your_pg_password
# DB_SSL=true

JWT_SECRET=change_this_to_a_random_secret_key
UPLOAD_PATH=uploads
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed browser origins. When unset, CORS is open.
# CORS_ORIGINS=https://your-app.vercel.app

# ============================================
# Upload storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
# ============================================
# When S3_BUCKET is set, submissions are stored in the bucket. Otherwise the
# local UPLOAD_PATH directory is used (dev fallback).
# S3_BUCKET=your-bucket-name
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key

# Email (SMTP)
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
